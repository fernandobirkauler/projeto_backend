  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "tokenGerente", "value": "" },
    { "key": "tokenCliente", "value": "" },
    { "key": "tokenCozinha", "value": "" },
    { "key": "pedidoId", "value": "" },
    { "key": "pedidoRecusaId", "value": "" },
    { "key": "unidadeCrudId", "value": "" },
    { "key": "produtoCrudId", "value": "" }
  ],
  "item": [
    {
