          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCozinha}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"PRONTO\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["pedidos", "{{pedidoId}}", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('erro padronizado', () => pm.expect(pm.response.json()).to.have.property('erro'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar pedido para recusa",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidade_id\": 1,\n  \"canalPedido\": \"WEB\",\n  \"itens\": [\n    { \"produto_id\": 1, \"quantidade\": 1 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "if (data.id) { pm.collectionVariables.set('pedidoRecusaId', data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Pagar pedido (recusado)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"aprovado\": false\n}" },
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoRecusaId}}/pagamento",
              "host": ["{{baseUrl}}"],
              "path": ["pedidos", "{{pedidoRecusaId}}", "pagamento"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('recusado', () => pm.expect(pm.response.json().status).to.eql('RECUSADO'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Estoque insuficiente - 409",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidade_id\": 1,\n  \"canalPedido\": \"BALCAO\",\n  \"itens\": [\n    { \"produto_id\": 1, \"quantidade\": 999999 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('mensagem de estoque', () => pm.expect(pm.response.json().erro.mensagem).to.include('Estoque'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pagar pedido ja pago - 409",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"aprovado\": true\n}" },
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoId}}/pagamento",
              "host": ["{{baseUrl}}"],
              "path": ["pedidos", "{{pedidoId}}", "pagamento"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Erros (erro JSON padronizado)",
      "item": [
        {
          "name": "Sem token - 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('erro padronizado', () => pm.expect(pm.response.json()).to.have.property('erro'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Canal invalido - 422",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidade_id\": 1,\n  \"canalPedido\": \"DRIVE\",\n  \"itens\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/pedidos", "host": ["{{baseUrl}}"], "path": ["pedidos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
                  "pm.test('tem detalhes', () => pm.expect(pm.response.json().erro).to.have.property('detalhes'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Campo obrigatorio ausente - 422",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Sem Email\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
                  "pm.test('lista os campos', () => pm.expect(pm.response.json().erro.detalhes.length).to.be.above(0));"
                ]
              }
            }
          ]
        }
